        exit 1
    fi

    "$EDITOR" "$CONFIG_FILE"

    echo
    echo "Configuration saved to:"
    echo "  $CONFIG_FILE"
    echo
    echo "Restarting bot..."

    start_bot

    echo "Bot restarted."
}

update_command() {
    require_root
    detect_arch

    echo "TelegramDirect update"
    echo "Architecture: linux-$ARCH"
    echo

    command -v curl >/dev/null 2>&1 ||
        die "curl is required."

    LATEST_TAG="$(get_latest_release)"

    [[ -n "$LATEST_TAG" ]] ||
        die "Could not determine latest GitHub release."

    echo "Latest release: $LATEST_TAG"

    RELEASE_URL="https://api.github.com/repos/$REPO/releases/tags/$LATEST_TAG"

    ASSET="suggestion-bot-linux-$ARCH"
    DOWNLOAD_URL="https://github.com/$REPO/releases/download/$LATEST_TAG/$ASSET"

    TMP_BINARY="$(mktemp)"
    TMP_CHECKSUMS="$(mktemp)"

    trap 'rm -f "$TMP_BINARY" "$TMP_CHECKSUMS"' EXIT

    echo "Downloading binary..."

    curl -fL "$DOWNLOAD_URL" -o "$TMP_BINARY"

    echo "Downloading checksums..."

    curl -fL \
        "https://github.com/$REPO/releases/download/$LATEST_TAG/checksums.txt" \
        -o "$TMP_CHECKSUMS"

    EXPECTED="$(
        awk -v file="$ASSET" '$2 == file {print $1}' "$TMP_CHECKSUMS"
    )"

    [[ -n "$EXPECTED" ]] ||
        die "Checksum for $ASSET was not found."

    ACTUAL="$(sha256sum "$TMP_BINARY" | awk '{print $1}')"

    if [[ "$EXPECTED" != "$ACTUAL" ]]; then
        die "SHA-256 checksum verification failed."
    fi

    echo "Checksum OK."

    mkdir -p "$APP_DIR"

    chmod 755 "$TMP_BINARY"

    echo "Installing new binary..."

    install -m 755 "$TMP_BINARY" "$BINARY"
    chown root:root "$BINARY"

    echo "Restarting bot..."

    start_bot

    echo
    echo "Update complete."
    echo "Version:      $LATEST_TAG"
    echo "Architecture: linux-$ARCH"
}

uninstall_command() {
    require_root

    echo "========================================"
    echo " TelegramDirect Uninstaller"
    echo "========================================"
    echo

    read -rp "Continue? [y/N]: " CONFIRM

    [[ "$CONFIRM" =~ ^[Yy]$ ]] || {
        echo "Cancelled."
        exit 0
    }

    echo
    echo "Stopping TelegramDirect..."

    # systemd
    if [[ -f "$SERVICE_FILE" ]]; then
        systemctl disable --now "$APP_NAME" 2>/dev/null || true
        rm -f "$SERVICE_FILE"
        systemctl daemon-reload
    fi

    # PM2
    PM2_HOME="$DATA_DIR/.pm2"

    if command -v pm2 >/dev/null 2>&1 && \
       id -u "$APP_NAME" >/dev/null 2>&1 && \
       [[ -d "$PM2_HOME" ]]; then

        runuser -u "$APP_NAME" -- \
            env PM2_HOME="$PM2_HOME" \
            pm2 delete "$APP_NAME" >/dev/null 2>&1 || true

        runuser -u "$APP_NAME" -- \
            env PM2_HOME="$PM2_HOME" \
            pm2 save >/dev/null 2>&1 || true
    fi

    echo
    echo "Application files:"
    echo "  $APP_DIR"

    rm -rf "$APP_DIR"

    echo
    echo "Persistent data:"
    echo "  $DATA_DIR"

    read -rp "Delete database and all persistent data? [y/N]: " REMOVE_DATA

    if [[ "$REMOVE_DATA" =~ ^[Yy]$ ]]; then
        rm -rf "$DATA_DIR"

        if id -u "$APP_NAME" >/dev/null 2>&1; then
            userdel "$APP_NAME" 2>/dev/null || true
        fi

        echo "Database and persistent data removed."
    else
        echo "Persistent data preserved."
    fi

    # Remove command itself
    rm -f /usr/local/bin/telegramdirect

    echo
    echo "TelegramDirect has been uninstalled."
}

show_help() {
    cat <<EOF
TelegramDirect

Usage:
  telegramdirect config
  telegramdirect update
  telegramdirect uninstall

Commands:

  config
      Edit config.json and restart the bot.

  update
      Download the latest GitHub Release, verify its SHA-256
      checksum and restart the bot.

  uninstall
      Stop the bot and remove the installation.
      Persistent data is deleted only after confirmation.

EOF
}

case "${1:-}" in
    config)
        config_command
        ;;

    update)
        update_command
        ;;

    uninstall)
        uninstall_command
        ;;

    help|-h|--help|"")
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac