#!/usr/bin/env bash
set -euo pipefail

APP_NAME="suggestion-bot"
APP_DIR="/opt/$APP_NAME"
DATA_DIR="/var/lib/$APP_NAME"
BINARY="$APP_DIR/$APP_NAME"
ENV_FILE="$APP_DIR/.env"
CONFIG_FILE="$APP_DIR/config.json"
SERVICE_FILE="/etc/systemd/system/$APP_NAME.service"
PM2_CONFIG="$APP_DIR/ecosystem.config.js"
REPO="DanMotive/TelegramDirect"

die() {
    echo "Error: $*" >&2
    exit 1
}

require_root() {
    [[ "${EUID}" -eq 0 ]] || die "Run this command with sudo."
}

detect_arch() {
    case "$(uname -m)" in
        x86_64)
            ARCH="amd64"
            ;;
        aarch64|arm64)
            ARCH="arm64"
            ;;
        *)
            die "Unsupported architecture: $(uname -m)"
            ;;
    esac
}

get_latest_release() {
    curl -fsSL \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/$REPO/releases/latest" |
        sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' |
        head -n 1
}

detect_manager() {
    if [[ -f "$SERVICE_FILE" ]]; then
        MANAGER="systemd"
        return
    fi

    if [[ -f "$PM2_CONFIG" ]]; then
        MANAGER="pm2"
        return
    fi

    MANAGER="unknown"
}

start_bot() {
    detect_manager

    case "$MANAGER" in
        systemd)
            systemctl restart "$APP_NAME"
            ;;

        pm2)
            PM2_HOME="$DATA_DIR/.pm2"

            runuser -u "$APP_NAME" -- \
                env PM2_HOME="$PM2_HOME" \
                pm2 restart "$APP_NAME"
            ;;

        *)
            die "Could not detect process manager."
            ;;
    esac
}

