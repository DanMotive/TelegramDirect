#!/usr/bin/env bash
set -euo pipefail

APP_NAME="suggestion-bot"
APP_DIR="/opt/$APP_NAME"
DATA_DIR="/var/lib/$APP_NAME"

BINARY="$APP_DIR/$APP_NAME"
RUNNER="$APP_DIR/run.sh"

ENV_FILE="$APP_DIR/.env"
CONFIG_FILE="$APP_DIR/config.json"

SERVICE_FILE="/etc/systemd/system/$APP_NAME.service"
PM2_CONFIG="$APP_DIR/ecosystem.config.js"

REPO="DanMotive/TelegramDirect"

die() {
    echo
    echo "Error: $*" >&2
    exit 1
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        die "Run this command with sudo."
    fi
}

detect_arch() {
    case "$(uname -m)" in
        x86_64)
            ARCH="amd64"
            ;;
        aarch64|arm64)
            ARCH="arm64"
            ;;
        *)
            die "Unsupported architecture: $(uname -m)"
            ;;
    esac
}

get_latest_release() {
    curl -fsSL \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/$REPO/releases/latest" |
        sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' |
        head -n 1
}

detect_manager() {
    if [[ -f "$SERVICE_FILE" ]]; then
        MANAGER="systemd"
        return
    fi

    if [[ -f "$PM2_CONFIG" ]]; then
        MANAGER="pm2"
        return
    fi

    MANAGER="unknown"
}

restart_bot() {
    detect_manager

    case "$MANAGER" in
        systemd)
            systemctl restart "$APP_NAME"
            ;;

        pm2)
            PM2_HOME="$DATA_DIR/.pm2"

            runuser -u "$APP_NAME" -- \
                env PM2_HOME="$PM2_HOME" \
                pm2 restart "$APP_NAME"
            ;;

        *)
            die "Could not detect process manager."
            ;;
    esac
}

config_command() {
    require_root

    [[ -f "$CONFIG_FILE" ]] ||
        die "config.json was not found: $CONFIG_FILE"

    EDITOR="${EDITOR:-nano}"

    if ! command -v "$EDITOR" >/dev/null 2>&1; then
        die "Editor '$EDITOR' is not installed."
    fi

    echo "Opening:"
    echo "  $CONFIG_FILE"
    echo

    "$EDITOR" "$CONFIG_FILE"

    echo
    echo "Configuration saved."

    read -rp "Restart TelegramDirect now? [Y/n]: " RESTART

    if [[ ! "$RESTART" =~ ^[Nn]$ ]]; then
        restart_bot
        echo "Bot restarted."
    fi
}

update_command() {
    require_root
    detect_arch

    command -v curl >/dev/null 2>&1 ||
        die "curl is required."

    [[ -f "$BINARY" ]] ||
        die "TelegramDirect is not installed correctly."

    LATEST_TAG="$(get_latest_release)"

    [[ -n "$LATEST_TAG" ]] ||
        die "Could not determine the latest GitHub release."

    echo "Latest release: $LATEST_TAG"
    echo "Architecture:   linux-$ARCH"
    echo

    ASSET="suggestion-bot-linux-$ARCH"

    DOWNLOAD_URL="https://github.com/$REPO/releases/download/$LATEST_TAG/$ASSET"
    CHECKSUM_URL="https://github.com/$REPO/releases/download/$LATEST_TAG/checksums.txt"

    TMP_BINARY="$(mktemp)"
    TMP_CHECKSUMS="$(mktemp)"

    cleanup() {
        rm -f "$TMP_BINARY" "$TMP_CHECKSUMS"
    }

    trap cleanup EXIT

    echo "Downloading binary..."

    curl -fL "$DOWNLOAD_URL" -o "$TMP_BINARY"

    echo "Downloading checksums..."

    curl -fL "$CHECKSUM_URL" -o "$TMP_CHECKSUMS"

    EXPECTED="$(
        awk -v file="$ASSET" '$2 == file {print $1}' "$TMP_CHECKSUMS"
    )"

    [[ -n "$EXPECTED" ]] ||
        die "Checksum for $ASSET was not found."

    ACTUAL="$(sha256sum "$TMP_BINARY" | awk '{print $1}')"

    if [[ "$EXPECTED" != "$ACTUAL" ]]; then
        die "SHA-256 checksum verification failed."
    fi

    echo "Checksum verified."

    chmod 755 "$TMP_BINARY"

    # Backup current binary before replacement.
    cp "$BINARY" "$BINARY.backup"

    if ! install -m 755 "$TMP_BINARY" "$BINARY"; then
        mv "$BINARY.backup" "$BINARY"
        die "Failed to install new binary. Previous binary restored."
    fi

    rm -f "$BINARY.backup"

    chown root:root "$BINARY"

    echo "Binary updated."

    restart_bot

    echo
    echo "Update complete."
    echo "Version: $LATEST_TAG"
}

uninstall_command() {
    require_root

    echo "========================================"
    echo " TelegramDirect Uninstaller"
    echo "========================================"
    echo

    echo "This will remove the TelegramDirect application."
    echo "The database and persistent data will be asked about separately."
    echo

    read -rp "Continue? [y/N]: " CONFIRM

    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        exit 0
    fi

    echo
    echo "Stopping services..."

    # systemd
    if [[ -f "$SERVICE_FILE" ]]; then
        systemctl disable --now "$APP_NAME" 2>/dev/null || true
        rm -f "$SERVICE_FILE"
        systemctl daemon-reload
    fi

    # PM2
    PM2_HOME="$DATA_DIR/.pm2"

    if command -v pm2 >/dev/null 2>&1 &&
       id -u "$APP_NAME" >/dev/null 2>&1 &&
       [[ -d "$PM2_HOME" ]]; then

        runuser -u "$APP_NAME" -- \
            env PM2_HOME="$PM2_HOME" \
            pm2 delete "$APP_NAME" >/dev/null 2>&1 || true

        runuser -u "$APP_NAME" -- \
            env PM2_HOME="$PM2_HOME" \
            pm2 save >/dev/null 2>&1 || true
    fi

    echo
    echo "Removing application files..."

    rm -rf "$APP_DIR"
    rm -f /usr/local/bin/telegramdirect

    echo
    if [[ -d "$DATA_DIR" ]]; then
        echo "Persistent data found:"
        echo "  $DATA_DIR"
        echo

        read -rp "Delete database and all persistent data? [y/N]: " REMOVE_DATA

        if [[ "$REMOVE_DATA" =~ ^[Yy]$ ]]; then
            rm -rf "$DATA_DIR"

            if id -u "$APP_NAME" >/dev/null 2>&1; then
                userdel "$APP_NAME" 2>/dev/null || true
            fi

            echo "Persistent data removed."
        else
            echo "Persistent data preserved at:"
            echo "  $DATA_DIR"
        fi
    else
        if id -u "$APP_NAME" >/dev/null 2>&1; then
            userdel "$APP_NAME" 2>/dev/null || true
        fi
    fi

    echo
    echo "TelegramDirect has been uninstalled."
}

show_help() {
    cat <<EOF
TelegramDirect

Usage:
  telegramdirect config
  telegramdirect update
  telegramdirect uninstall
  telegramdirect help

Commands:

  config
      Edit config.json and optionally restart the bot.

  update
      Download the latest GitHub Release, verify its SHA-256
      checksum, replace the binary and restart the bot.

  uninstall
      Stop TelegramDirect and remove the installation.
      Persistent data is deleted only after confirmation.

EOF
}

case "${1:-help}" in
    config)
        config_command
        ;;

    update)
        update_command
        ;;

    uninstall)
        uninstall_command
        ;;

    help|--help|-h)
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac